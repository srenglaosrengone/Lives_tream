# Facebook API Configuration (Required for Auto-Go-Live)
PAGE_ACCESS_TOKEN=your_page_access_token_here
PAGE_ID=your_page_id_here

# Video Configuration
VIDEO_URL=https://your-direct-video-link.mp4
VIDEO_FILE=video.mp4
FORCE_DOWNLOAD=false

# Streaming Settings
PLATFORM=facebook
VIDEO_BITRATE=4500k
AUDIO_BITRATE=192k
STREAM_FPS=30
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
FFMPEG_PRESET=ultrafast

# Server Settings
PORT=10000
MEMORY_LIMIT_MB=2048
CPU_MODEL=Standard Instance
